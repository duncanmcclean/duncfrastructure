#!/usr/bin/env bash
#
# Sets up a fresh Forge server: loads my aliases for the forge user.
#
# Usage: bootstrap

set -euo pipefail
shopt -s inherit_errexit

if [[ $EUID -ne 0 ]]; then
    echo "This script must be run as root." >&2
    exit 1
fi

repository=$(dirname "$(realpath "$0")")
aliases="source $repository/bash/aliases.sh"

if ! grep --quiet --line-regexp --fixed-strings "$aliases" /home/forge/.bashrc; then
    echo "$aliases" | sudo --user forge tee --append /home/forge/.bashrc > /dev/null
fi
